    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/NoteFerry/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Script/MetroDevProcesses",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/NoteFerry.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "bin": {
    "metro-dev-processes": "./Distribution/index.js"
  },
  "scripts": {
