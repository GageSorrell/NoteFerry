{
  "name": "@noteferry/avd-demo-mode",
  "description": "Toggles Android System UI demo mode, animation scale, and heads-up notifications on a running AVD, for clean screenshots and recordings, with optional hidden status bar icons.",
  "private": true,
  "homepage": "https://noteferry.sorrell.sh",
  "version": "1.0.0",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/NoteFerry/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Script/AvdDemoMode",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/NoteFerry.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "bin": {
    "avd-demo-mode": "./Distribution/index.js"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "start": "npm run toggle",
    "toggle": "node ./Distribution/index.js",
    "enable": "node ./Distribution/index.js --enable",
    "enable:hide": "node ./Distribution/index.js --enable --hidden",
    "enable:show": "node ./Distribution/index.js --enable --no-hidden",
    "disable": "node ./Distribution/index.js --disable"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "effect": "4.0.3",
    "ora": "9.4.1"
  },
  "devDependencies": {
    "@sorrell/tsconfig": "2.1.0",
    "typescript": "6.0.3"
  }
}
