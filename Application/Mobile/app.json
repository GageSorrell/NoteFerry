{
  "expo": {
    "name": "NoteFerry",
    "slug": "notivex",
    "owner": "gagesorrell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Resource/Logo/NoteFerryLogoLight.png",
    "scheme": "noteferry",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": {
        "light": "./Resource/Logo/NoteFerryLogoLight.png",
        "dark": "./Resource/Logo/NoteFerryLogoDark.png",
        "tinted": "./Resource/Logo/NoteFerryLogoLight.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.sorrell.noteferry",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./Resource/Logo/NoteFerryAdaptiveForeground.png",
        "monochromeImage": "./Resource/Logo/NoteFerryAdaptiveMono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./Resource/Logo/NoteFerryLogoLight.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./Resource/Logo/NoteFerryLogoLight.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./Resource/Logo/NoteFerryLogoDark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach them to your notes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
