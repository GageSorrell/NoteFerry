{
  "expo": {
    "name": "Notivex",
    "slug": "notivex",
    "owner": "gagesorrell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Resource/NotivexLogoLight.png",
    "scheme": "notivex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./Resource/NotivexLogoLight.png",
        "dark": "./Resource/NotivexLogoDark.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sorrell.notivex",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./Resource/NotivexAdaptiveForeground.png",
        "monochromeImage": "./Resource/NotivexAdaptiveMono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./Resource/NotivexLogoLight.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./Resource/NotivexLogoLight.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./Resource/NotivexLogoDark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "./Source/App"
      },
      "eas": {
        "projectId": "1962a247-404a-4a87-ad8a-db4c4e7a7094"
      }
    }
  }
}
