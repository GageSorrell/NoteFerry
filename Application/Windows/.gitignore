# Subversion files
.svn

# Office temp files
~$*

# vim temp files
*~

# NuGet
packages/
*.nupkg

# ncrunch
*ncrunch*
*crunch*.local.xml

# Visual Studio database projects
*.dbmdl

# Test files
*.testsettings

# Other files
*.DotSettings
*project.lock.json

# Files generated by the VS build
**/Generated Files/**

# Files generated by MSBuild
*.binlog
*.err
*.wrn

# Compiler intermediate/debug database files (also not in the stock
# template above, but real local-build leftovers all the same)
*.idb
*.pdb

# Visual C++'s default $(Platform)\$(Configuration) solution-level output
# directories (e.g. windows/x64/Debug, windows/Windows/x64/Debug) — not part
# of react-native-windows's own template, but real build output all the
# same; [Bb]in/[Oo]bj above only catch per-project MSBuild output, not this
# solution-level one.
windows/x64/
windows/x86/
windows/ARM/
windows/ARM64/
windows/*/x64/
windows/*/x86/
windows/*/ARM/
windows/*/ARM64/
