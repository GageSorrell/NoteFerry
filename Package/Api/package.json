{
  "name": "@notivex/api",
  "description": "The API with which Notivex interacts with the backend.",
  "private": true,
  "homepage": "https://notivex.sorrell.sh",
  "version": "1.0.0",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/Notivex/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Package/Api",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/Notivex.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./Connections": {
      "import": "./Distribution/Connections.js",
      "types": "./Distribution/Connections.d.ts"
    },
    "./DataSources": {
      "import": "./Distribution/DataSources.js",
      "types": "./Distribution/DataSources.d.ts"
    },
    "./Destinations": {
      "import": "./Distribution/Destinations.js",
      "types": "./Distribution/Destinations.d.ts"
    },
    "./Pages": {
      "import": "./Distribution/Pages.js",
      "types": "./Distribution/Pages.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "@notivex/domain": "1.0.0",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@sorrell/tsconfig": "2.1.0",
    "@testing-library/react-native": "14.0.1",
    "typescript": "6.0.3"
  }
}
