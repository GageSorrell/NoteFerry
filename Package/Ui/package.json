{
  "name": "@noteferry/ui",
  "description": "The UI library of noteferry.",
  "private": false,
  "homepage": "https://noteferry.sorrell.sh",
  "version": "1.0.0",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/NoteFerry/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Package/Ui",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/NoteFerry.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./Block": {
      "import": "./Distribution/Block/index.js",
      "types": "./Distribution/Block/index.d.ts"
    },
    "./Block/*": {
      "import": "./Distribution/Block/*.js",
      "types": "./Distribution/Block/*.d.ts"
    },
    "./Core": {
      "import": "./Distribution/Core.js",
      "types": "./Distribution/Core.d.ts"
    },
    "./Token": {
      "import": "./Distribution/Token/index.js",
      "types": "./Distribution/Token/index.d.ts"
    },
    "./Primitive": {
      "import": "./Distribution/Primitive/index.js",
      "types": "./Distribution/Primitive/index.d.ts"
    },
    "./Primitive/*": {
      "import": "./Distribution/Primitive/*.js",
      "types": "./Distribution/Primitive/*.d.ts"
    },
    "./Platform": {
      "import": "./Distribution/Platform/index.js",
      "types": "./Distribution/Platform/index.d.ts"
    },
    "./rich-editor": {
      "import": "./Distribution/rich-editor/index.js",
      "types": "./Distribution/rich-editor/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "test": "npm run build && node --test Test/*.test.mjs"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.11",
    "expo": "~57.0.13",
    "expo-image": ">=57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-router": "~57.0.11",
    "react": ">=19.2.0",
    "react-native": ">=0.84.0",
    "react-native-enriched-markdown": ">=1.0.2",
    "react-native-gesture-handler": ">=2.32.0",
    "react-native-reanimated": ">=4.5.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.4"
  },
  "peerDependenciesMeta": {
    "@expo/ui": { "optional": true },
    "expo": { "optional": true },
    "expo-image": { "optional": true },
    "expo-image-picker": { "optional": true },
    "expo-router": { "optional": true },
    "react-native-gesture-handler": { "optional": true },
    "react-native-reanimated": { "optional": true }
  },
  "dependencies": {
    "@sorrell/effect": "1.0.1",
    "@sorrell/utility": "2.0.1",
    "@better-fetch/fetch": "1.3.1",
    "@emoji-mart/data": "1.2.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@noteferry/notion-markdown": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@sorrell/react": "1.1.3",
    "date-fns": "4.4.0",
    "effect": "4.0.0-rc.109",
    "jotai": "2.20.2",
    "lucide-react-native": "1.28.0",
    "react-hook-form": "7.84.0",
    "react-native-calendars": "1.1314.0",
    "react-native-gesture-handler": ">=2.32.0",
    "react-native-popover-view": "6.1.0",
    "react-native-reanimated": ">=4.5.0",
    "test-renderer": "1.2.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@sorrell/tsconfig": "2.1.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.18",
    "jest-expo": "~57.0.4",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "1.0.2",
    "typescript": "6.0.3"
  }
}
