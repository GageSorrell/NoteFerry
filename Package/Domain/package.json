{
  "name": "@notivex/domain",
  "description": "Schemas and data utilities shared across the monorepo.",
  "private": true,
  "homepage": "https://notivex.sorrell.sh",
  "version": "1.0.0",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/Notivex/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Package/Domain",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/Notivex.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./DataSource": {
      "import": "./Distribution/DataSource.js",
      "types": "./Distribution/DataSource.d.ts"
    },
    "./Destination": {
      "import": "./Distribution/Destination.js",
      "types": "./Distribution/Destination.d.ts"
    },
    "./Command": {
      "import": "./Distribution/Command.js",
      "types": "./Distribution/Command.d.ts"
    },
    "./Error": {
      "import": "./Distribution/Error.js",
      "types": "./Distribution/Error.d.ts"
    },
    "./Id": {
      "import": "./Distribution/Id.js",
      "types": "./Distribution/Id.d.ts"
    },
    "./NotionConnection": {
      "import": "./Distribution/NotionConnection.js",
      "types": "./Distribution/NotionConnection.d.ts"
    },
    "./PageDraft": {
      "import": "./Distribution/PageDraft.js",
      "types": "./Distribution/PageDraft.d.ts"
    },
    "./Property": {
      "import": "./Distribution/Property.js",
      "types": "./Distribution/Property.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "effect": "4.0.0-beta.104"
  },
  "devDependencies": {
    "@sorrell/tsconfig": "2.1.0",
    "@testing-library/react-native": "14.0.1",
    "typescript": "6.0.3"
  }
}
