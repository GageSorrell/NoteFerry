{
    "extends": "@sorrell/tsconfig",
    "compilerOptions": {
        "noEmit": false,
        "module": "NodeNext",
        "moduleDetection": "force",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "Distribution",
        "rootDir": "Source",
        "tsBuildInfoFile": "Intermediate/TypeScript/tsconfig.tsbuildinfo",
        "types": [ "node" ]
    },
    "include": [ "Source" ]
}
