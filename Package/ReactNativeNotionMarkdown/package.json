{
  "name": "@noteferry/react-native-notion-markdown",
  "description": "Notion's Enhanced Markdown format, parsed, rendered, and edited in React Native.",
  "private": false,
  "homepage": "https://noteferry.sorrell.sh",
  "version": "0.1.0",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/NoteFerry/issues"
  },
  "license": "MIT",
  "repository": {
    "directory": "Package/ReactNativeNotionMarkdown",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/NoteFerry.git"
  },
  "engines": {
    "node": "24.19.0",
    "npm": ">=12.0.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./Core": {
      "import": "./Distribution/Core.js",
      "types": "./Distribution/Core.d.ts"
    },
    "./LucideIcons": {
      "import": "./Distribution/LucideIcons.js",
      "types": "./Distribution/LucideIcons.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json && node ./Script/build-lucide.mjs",
    "test": "npm run build && node --test Test/*.test.mjs"
  },
  "dependencies": {
    "@notionhq/client": "5.23.3"
  },
  "peerDependencies": {
    "lucide-react-native": "*",
    "react": ">=19.2.0",
    "react-native": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sorrell/tsconfig": "2.1.0",
    "@types/react": "19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
